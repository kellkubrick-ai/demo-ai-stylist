DATABASE_URL=postgresql+asyncpg://stylist:stylist@localhost:5432/stylist
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
# OpenRouter model IDs (without the pydantic-ai 'openrouter:' prefix).
INTENT_MODEL=
ENRICHMENT_MODEL=
STYLIST_MODEL=
RESPONSE_MODEL=
# OpenRouter reasoning effort: none, minimal, low, medium, high, or xhigh.
INTENT_REASONING_EFFORT=medium
ENRICHMENT_REASONING_EFFORT=low
STYLIST_REASONING_EFFORT=high
RESPONSE_REASONING_EFFORT=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
MAX_CANDIDATES=30
OFFLINE_CONCURRENCY=2
REQUEST_TIMEOUT_SECONDS=120
DATA_DIR=data
KNOWLEDGE_DIR=knowledge
# Dedicated test database; never point this at a catalog you want to keep.
TEST_DATABASE_URL=
